SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# Cheap guard for the legacy /upload endpoint — abuse prevention only, not a real secret
ADMIN_UPLOAD_PLACEHOLDER_TOKEN=generate-a-random-hex-string-here
# SUPABASE_SERVICE_ROLE_KEY is intentionally NOT stored in .env.
# Pass it at runtime only: SUPABASE_SERVICE_ROLE_KEY=sb_secret_... node scripts/seed-events.js
